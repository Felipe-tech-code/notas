rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isUs() {
      return request.auth != null
        && request.auth.token.email in ['felipe@nossalista.local', 'mayara@nossalista.local'];
    }
    function me() {
      return request.auth.token.email.split('@')[0];
    }

    // Desejos: os dois leem; cada um só cria, edita e apaga os próprios.
    match /lists/nossa/items/{itemId} {
      allow read: if isUs();
      allow create: if isUs() && request.resource.data.owner == me();
      allow update: if isUs() && resource.data.owner == me() && request.resource.data.owner == me();
      allow delete: if isUs() && resource.data.owner == me();
    }

    // Reservas: cada um só vê as próprias (o dono do desejo não vê o que foi reservado).
    match /lists/nossa/marks/{giver}/items/{itemId} {
      allow read, write: if isUs() && giver == me();
    }

    // Presentes entregues: os dois veem; só quem deu cria, altera ou desfaz.
    match /lists/nossa/given/{itemId} {
      allow read: if isUs();
      allow create: if isUs() && request.resource.data.giver == me() && request.resource.data.receiver != me();
      allow update: if isUs() && resource.data.giver == me() && request.resource.data.giver == me() && request.resource.data.receiver != me();
      allow delete: if isUs() && resource.data.giver == me();
    }

    // Recadinhos: os dois leem; cada um escreve e apaga os seus.
    match /lists/nossa/notes/{noteId} {
      allow read: if isUs();
      allow create: if isUs() && request.resource.data.from == me();
      allow delete: if isUs() && resource.data.from == me();
    }

    // Data do namoro e apelidos.
    match /lists/nossa/meta/{docId} {
      allow read, write: if isUs();
    }

    // Sonhos a dois: os dois veem, marcam como realizado e apagam.
    match /lists/nossa/dreams/{dreamId} {
      allow read, delete: if isUs();
      allow create: if isUs() && request.resource.data.by == me();
      allow update: if isUs() && request.resource.data.by == resource.data.by;
    }

    // Memórias (miniatura) e a foto grande; só quem guardou apaga.
    match /lists/nossa/memories/{memId} {
      allow read: if isUs();
      allow create: if isUs() && request.resource.data.by == me() && request.resource.data.thumb.size() < 200000;
      allow delete: if isUs() && resource.data.by == me();
    }
    match /lists/nossa/memPhotos/{memId} {
      allow read: if isUs();
      allow create: if isUs() && request.resource.data.by == me() && request.resource.data.data.size() < 1000000;
      allow delete: if isUs() && resource.data.by == me();
    }

    // Cartas: o envelope (título e data) os dois veem.
    match /lists/nossa/letters/{letterId} {
      allow read: if isUs();
      allow create: if isUs() && request.resource.data.from == me() && request.resource.data.to != me();
      allow delete: if isUs() && resource.data.from == me();
    }
    // O texto da carta só abre pra quem escreveu ou depois da data escolhida.
    match /lists/nossa/letterBodies/{letterId} {
      allow read: if isUs() && (resource.data.from == me() || request.time >= resource.data.openAt);
      allow create: if isUs() && request.resource.data.from == me() && request.resource.data.openAt is timestamp;
      allow delete: if isUs() && resource.data.from == me();
    }

    // Vales-amor: quem dá cria e apaga; só quem recebeu marca como usado.
    match /lists/nossa/coupons/{couponId} {
      allow read: if isUs();
      allow create: if isUs() && request.resource.data.from == me() && request.resource.data.to != me();
      allow update: if isUs() && resource.data.to == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt']);
      allow delete: if isUs() && resource.data.from == me();
    }

    // Playlist: os dois veem; cada um apaga as músicas que colocou.
    match /lists/nossa/songs/{songId} {
      allow read: if isUs();
      allow create: if isUs() && request.resource.data.by == me();
      allow delete: if isUs() && resource.data.by == me();
    }
  }
}
